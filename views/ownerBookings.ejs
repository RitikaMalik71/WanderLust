
<% layout("/layout/boilerplate") %>
<div class="container mx-auto p-4">
  <h1 class="text-2xl font-bold mb-6">Bookings for Your Listings</h1>

  <% if (bookings.length === 0) { %>
    <p class="text-gray-600">No bookings found for your listings.</p>
  <% } else { %>
    <div class="space-y-6">
      <% bookings.forEach(booking => { %>
        <div class="border p-4 rounded-lg shadow">
          <h2 class="text-xl font-semibold mb-2"><%= booking.listing.title %></h2>
          <p><strong>Guest:</strong> <%= booking.user.email %></p>
          <p><strong>Adults:</strong> <%= booking.adults %> | <strong>Children:</strong> <%= booking.children %></p>
          <p><strong>Check-in:</strong> <%= booking.checkin.toDateString() %></p>
          <p><strong>Check-out:</strong> <%= booking.checkout.toDateString() %></p>
          <p><strong>Sustainability Project:</strong> <%= booking.participateInSustainability ? "Yes" : "No" %></p>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>


