<% layout("/layout/boilerplate") %>
<script>
  const mapToken="<%=process.env.MAP_TOKEN%>";
   const coordinates=<%-JSON.stringify (listings.geometry.coordinates)%>;
   console.log(coordinates);
   console.log(typeof(coordinates));
 
</script>

<body>
    <div class="row">
        <div class="col-8 offset-3">
    <h3 class="mt-3"><%=listings.title%></h3> </div>
    <div class="card col-6 offset-3 show-card listing-card">
        <img src=<%=listings.image.url%> class="card-img-top show-img" alt="listing-image">
  <div class="card-body">
    <p class="card-text">
       <p><i>Owned by <%=listings.owner.username%></i>
       </p>
       <p><%=listings.description%></p> 
        <p>&#8377; <%=listings.price.toLocaleString("en-IN")%></p>
        <p><%=listings.location%></p>
        <p><%=listings.country%></p>
        <p><%=listings.category%>     </p>
        <% if (currUser && !listings.owner._id.equals(currUser._id)) { %>
          <a href="/listings/<%= listings._id %>/book" class="btn btn-dark add-btn">Book this Property</a>
        <% } %>

        <% if (currUser && listings.owner._id.toString() === currUser._id.toString()) { %>
          <a href="/listings/<%= listings._id %>/showbookings" class="btn btn-dark add-btn">
            View All My Bookings
          </a>
        <% } %>
    </p>
    <div class="d-flex  align-items-center mt-5" style="height: 110vh; width: 100%;">
      <div style="width: 530px; height: 100%; display: flex; flex-direction: column; justify-content:center;">
        <% if (weather) { %>
          <div class="card shadow-sm border-1 p-4" style="height: 100%; width: 100%;">
            <div class="card-body d-flex flex-column align-items-center text-center gap-3 h-100 justify-content-center">
              <img src="http://openweathermap.org/img/wn/<%= weather.weather[0].icon %>@4x.png"
                   alt="Weather icon"
                   class="img-fluid"
                   style="width: 120px; height: 120px;">
              <h5 class="card-title">Weather in <%= listings.location %></h5>
              <p><strong>Temperature:</strong> <%= weather.main.temp %>°C (Feels like <%= weather.main.feels_like %>°C)</p>
              <p><strong>Condition:</strong> <%= weather.weather[0].description %></p>
              <p><strong>Humidity:</strong> <%= weather.main.humidity %>%</p>
              <% } else { %>
                <div class="alert alert-secondary text-center p-4 h-100 d-flex align-items-center justify-content-center">
                  Weather data is currently unavailable.
                </div>
              <% } %>
              <% if (aqi) { %>
                <hr style="width: 80%;">
                <h6 class="mt-2">Air Quality Index (AQI)</h6>
                <p><strong>AQI Level:</strong> <%= aqi.main.aqi %> - 
                  <% if (aqi.main.aqi == 1) { %> Good 
                  <% } else if (aqi.main.aqi == 2) { %> Fair 
                  <% } else if (aqi.main.aqi == 3) { %> Moderate 
                  <% } else if (aqi.main.aqi == 4) { %> Poor 
                  <% } else if (aqi.main.aqi == 5) { %> Very Poor 
                  <% } %>
                </p>
                <p><strong>PM2.5:</strong> <%= aqi.components.pm2_5 %> µg/m³</p>
                <p><strong>PM10:</strong> <%= aqi.components.pm10 %> µg/m³</p>
                <p><strong>O₃ (Ozone):</strong> <%= aqi.components.o3 %> µg/m³</p>
                <p><strong>CO (Carbon Monoxide):</strong> <%= aqi.components.co %> µg/m³</p>
              <% } else { %>
                <p class="text-muted">AQI data is currently unavailable.</p>
              <% } %>
      
            </div>
          </div>
        
      </div>
    </div>
    
  </div>
    </div>
    <%if(currUser&&listings.owner._id.equals(currUser._id)){%>
      <div class="btns col-8 offset-3">
        <form method="get" action="/listings/<%=listings._id%>/edit"><button class=" btn btn-dark add-btn  offset-3">Edit </button></form>
    
        <form method="post" action="/listings/<%=listings._id%>?_method=DELETE"><button class=" btn btn-dark   offset-5">Delete</button></form>
       </div>

   <% }%>
      


    
      
       <br>
       <br>
       
       
      
      
      
          <div class="col-8 offset-3">    
         
            
            <%if(currUser){ %>  
             
             
              
              <hr> 
              <h3>Leave a Review</h3>
               <form action="/listings/<%=listings._id%>/reviews" method="post" novalidate class="needs-validation">
               
                  <label for="rating" class="form-label">Rating</label> 
<fieldset class="starability-slot">
  

  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="review[rating]"value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="review[rating]"value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>


          <div class="mb-3 mt-3">
            <label for="comment"  class="form-label">Comments</label>
            <textarea 
            name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
            <div class="invalid-feedback">Please add some comments for review</div>
          
            
          </div>
      
            <button class="btn btn-outline-dark">Submit</button>
          </form>
         
       
   <hr>
      </form>
   <% }%>
   
      <%if(listings.reviews.length>0){%>

   
    <div class="row">
      <p><b>All reviews</b></p>
      <% for(review of listings.reviews){%>
        <div class="card col-5 ms-3 mb-3">
          <div class="card-body">
            <h5 class="card-title">@<%=review.author.username%></h5>
            <p class="starability-result card-text" data-rating="<%=review.rating%>"></p>
            <p class="card-text"><%=review.comment%></p>

            
           
          
            </p>
          </div>
          <%if(currUser&&listings.owner._id.equals(currUser._id)){%>
        <form method="POST" action="/listings/<%=listings._id%>/reviews/<%=review._id%>?_method=DELETE">
          <button class="btn btn-sm btn-dark">Delete</button>
          <% }%>
          <br>
          <br>
        </form>
        
        </div>
               <% }%>
    </div>
  <%}%>
    </div>   
    <div class="col-8 offset-3">
      <h4>Where you'll be </h4>
      <div id="map"></div>
    </div> 

</div>

<br>
<br>
<script src="/js/map.js"></script>
</body>
